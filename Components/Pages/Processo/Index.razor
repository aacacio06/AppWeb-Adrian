@page "/processo"
@page "/processos"
@using AppWeb_Adriann.DAO
@using AppWeb_Adriann.Model
@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Consulta de Processos</h2>
    </div>
</div>

<div class="custom-table-card">
    <div class="table-responsive">

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (erro is not null)
                {
                    <tr><td colspan="6" class="text-danger">@erro</td></tr>
                }
                else if (processos.Count == 0)
                {
                    <tr><td colspan="6">Nenhum processo encontrado.</td></tr>
                }
                else
                {
                    @foreach (var processo in processos)
                    {
                        <tr>
                            <td>@processo.Id</td>
                            <td>@processo.Numero</td>
                            <td>@processo.Interessado</td>
                            <td>@processo.Assunto</td>
                            <td>@processo.Situacao</td>
                            <td><button type="button" class="btn btn-sm btn-outline-primary" disabled>Visualizar</button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@code {
    private List<Processo> processos = new();
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            processos = ProcessoDAO.Listar();
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os processos. Verifique a conexão com o banco de dados.";
        }
    }
}
